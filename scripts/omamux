#!/usr/bin/env bash

set -euo pipefail

readonly HOST_ID="local"
readonly STATE_ROOT="${XDG_STATE_HOME:-${HOME}/.local/state}/omamux"
readonly STATE_FILE="${OMAMUX_STATE_FILE:-${STATE_ROOT}/favorites.json}"
readonly TMUX_BIN="${OMAMUX_TMUX_BIN:-tmux}"
readonly HYPRCTL_BIN="${OMAMUX_HYPRCTL_BIN:-hyprctl}"
readonly INPUT_OVERFLOW_STATUS=90
readonly MAX_STATE_BYTES=$((256 * 1024))
readonly MAX_HYPR_CLIENT_BYTES=$((2 * 1024 * 1024))
readonly MAX_TMUX_CLIENT_BYTES=$((512 * 1024))
readonly MAX_TMUX_SESSION_BYTES=$((512 * 1024))
readonly MAX_TMUX_PANE_BYTES=$((2 * 1024 * 1024))
readonly MAX_FAVORITES=256
readonly MAX_HYPR_CLIENTS=1024
readonly MAX_TMUX_CLIENTS=1024
readonly MAX_TMUX_SESSIONS=512
readonly MAX_TMUX_PANES=2048
readonly MAX_SESSION_NAME_BYTES=256
readonly MAX_WINDOW_NAME_BYTES=512
readonly MAX_PANE_TITLE_BYTES=1024
readonly MAX_PANE_COMMAND_BYTES=256
readonly MAX_PANE_PATH_BYTES=4096
readonly MAX_HYPR_ADDRESS_BYTES=64
readonly MAX_HYPR_CLASS_BYTES=256
readonly MAX_HYPR_TITLE_BYTES=1024
readonly MAX_WORKSPACE_NAME_BYTES=256
readonly MAX_COMMAND_ERROR_BYTES=512
readonly MAX_TMUX_COMMAND_BYTES=$((64 * 1024))
readonly MAX_HOSTNAME_BYTES=255
readonly MAX_TMUX_VERSION_BYTES=128

TMUX_ARGS=()
if [[ -n ${OMAMUX_TMUX_SOCKET:-} ]]; then
  TMUX_ARGS=(-L "$OMAMUX_TMUX_SOCKET")
fi

plain_json_error() {
  local message=${1:-"Omamux failed"}
  message=${message//\\/\\\\}
  message=${message//\"/\\\"}
  message=${message//$'\n'/\\n}
  printf '{"ok":false,"error":"%s"}\n' "$message"
}

if ! command -v jq >/dev/null 2>&1; then
  plain_json_error "jq is required by Omamux"
  exit 127
fi

json_error() {
  jq -cn --arg error "${1:-Omamux failed}" '{ok: false, error: $error}'
}

fail() {
  json_error "$1"
  exit "${2:-1}"
}

# Keep external producer output out of unbounded shell variables. The producer
# is stopped after limit + 1 bytes, which lets callers reject overflow before
# passing any of the data to jq or row parsers.
bounded_command_output() {
  local destination=$1 limit=$2
  shift 2
  local -n destination_ref=$destination
  local tmp byte_count command_status limiter_status had_errexit=0
  local -a pipeline_status

  destination_ref=''
  tmp=$(mktemp "${TMPDIR:-/tmp}/omamux.capture.XXXXXX") || return 1
  [[ $- == *e* ]] && had_errexit=1
  set +e
  "$@" 2>&1 | LC_ALL=C head -c "$((limit + 1))" >"$tmp"
  pipeline_status=("${PIPESTATUS[@]}")
  (( had_errexit == 0 )) || set -e

  command_status=${pipeline_status[0]:-1}
  limiter_status=${pipeline_status[1]:-1}
  byte_count=$(LC_ALL=C wc -c <"$tmp")
  if (( byte_count > limit )); then
    rm -f -- "$tmp"
    return "$INPUT_OVERFLOW_STATUS"
  fi
  if (( limiter_status != 0 )); then
    rm -f -- "$tmp"
    return "$limiter_status"
  fi

  destination_ref=$(<"$tmp")
  rm -f -- "$tmp"
  return "$command_status"
}

command_error_excerpt() {
  local destination=$1 value=$2
  local -n destination_ref=$destination
  LC_ALL=C printf -v destination_ref '%.*s' "$MAX_COMMAND_ERROR_BYTES" "$value"
}

string_fits() {
  local value=$1 limit=$2
  (( $(LC_ALL=C printf '%s' "$value" | wc -c) <= limit ))
}

# Capture JSON-producing helpers without swallowing their structured failure
# output. A plain `value=$(helper)` under `set -e` exits the parent immediately
# and leaves the captured error unavailable to the QML caller.
capture_json() {
  local destination=$1
  shift
  local value status

  set +e
  value=$("$@")
  status=$?
  set -e

  if (( status != 0 )); then
    printf '%s\n' "$value"
    exit "$status"
  fi
  printf -v "$destination" '%s' "$value"
}

tmux_available() {
  command -v "$TMUX_BIN" >/dev/null 2>&1
}

tmux_command() {
  "$TMUX_BIN" "${TMUX_ARGS[@]}" "$@"
}

tmux_command_quiet() {
  tmux_command "$@" 2>/dev/null
}

hostname_command() {
  hostname 2>/dev/null
}

hypr_clients_command() {
  "$HYPRCTL_BIN" clients -j 2>/dev/null
}

process_parent() {
  local pid=$1 key value
  [[ -r /proc/$pid/status ]] || return 1
  while read -r key value _; do
    if [[ $key == "PPid:" ]]; then
      printf '%s\n' "$value"
      return 0
    fi
  done <"/proc/$pid/status"
  return 1
}

hypr_clients_json() {
  local clients status
  command -v "$HYPRCTL_BIN" >/dev/null 2>&1 || return 1
  if bounded_command_output clients "$MAX_HYPR_CLIENT_BYTES" \
      hypr_clients_command; then
    :
  else
    status=$?
    (( status == INPUT_OVERFLOW_STATUS )) && return "$status"
    return 1
  fi

  jq -e '
    type == "array"
    and all(.[];
      type == "object"
      and (.pid | type) == "number"
      and (.address | type) == "string"
      and ((.class == null) or ((.class | type) == "string"))
      and ((.title == null) or ((.title | type) == "string"))
      and ((.workspace == null) or ((.workspace | type) == "object"))
      and ((.workspace.id == null) or ((.workspace.id | type) == "number"))
      and ((.workspace.name == null) or ((.workspace.name | type) == "string")))
  ' <<<"$clients" >/dev/null 2>&1 || return 1

  jq -e \
    --argjson maxRows "$MAX_HYPR_CLIENTS" \
    --argjson maxAddress "$MAX_HYPR_ADDRESS_BYTES" \
    --argjson maxClass "$MAX_HYPR_CLASS_BYTES" \
    --argjson maxTitle "$MAX_HYPR_TITLE_BYTES" \
    --argjson maxWorkspace "$MAX_WORKSPACE_NAME_BYTES" '
      length <= $maxRows
      and all(.[];
        (.address | utf8bytelength) <= $maxAddress
        and ((.class // "") | utf8bytelength) <= $maxClass
        and ((.title // "") | utf8bytelength) <= $maxTitle
        and ((.workspace.name // "") | utf8bytelength) <= $maxWorkspace)
    ' <<<"$clients" >/dev/null 2>&1 || return "$INPUT_OVERFLOW_STATUS"

  jq -ce 'map({
    address,
    pid,
    class: (.class // ""),
    title: (.title // ""),
    workspace: {
      id: (.workspace.id // null),
      name: (.workspace.name // "")
    }
  })' <<<"$clients" 2>/dev/null
}

hypr_window_for_process_json() {
  local ancestor=$1 hypr_clients=$2 match parent depth=0
  while [[ $ancestor =~ ^[0-9]+$ ]] && (( ancestor > 1 && depth < 64 )); do
    match=$(jq -c --argjson pid "$ancestor" '
      first(.[] | select(.pid == $pid) | {
        address,
        pid,
        class,
        title,
        workspace: (.workspace // {})
      }) // empty
    ' <<<"$hypr_clients")
    if [[ -n $match ]]; then
      printf '%s\n' "$match"
      return 0
    fi
    parent=$(process_parent "$ancestor") || break
    [[ $parent != "$ancestor" ]] || break
    ancestor=$parent
    ((depth += 1))
  done
  return 1
}

local_desktop_client_json() {
  local name=$1 hypr_clients clients activity pid match status
  if hypr_clients=$(hypr_clients_json); then
    :
  else
    status=$?
    (( status == INPUT_OVERFLOW_STATUS )) && return "$status"
    return 1
  fi
  if bounded_command_output clients "$MAX_TMUX_CLIENT_BYTES" \
      tmux_command_quiet list-clients -t "=$name" \
      -F $'#{client_activity}\t#{client_pid}'; then
    :
  else
    status=$?
    (( status == INPUT_OVERFLOW_STATUS )) && return "$status"
    return 1
  fi

  jq -Rse '
    split("\n") | map(select(length > 0))
    | all(.[];
        split("\t") as $fields
        | ($fields | length) == 2
          and ($fields[0] | test("^[0-9]+$"))
          and ($fields[1] | test("^[0-9]+$")))
  ' <<<"$clients" >/dev/null 2>&1 || return 1
  jq -Rse --argjson maxRows "$MAX_TMUX_CLIENTS" '
    split("\n") | map(select(length > 0))
    | length <= $maxRows
      and all(.[];
        split("\t")
        | (.[0] | utf8bytelength) <= 20
          and (.[1] | utf8bytelength) <= 20)
  ' <<<"$clients" >/dev/null 2>&1 || return "$INPUT_OVERFLOW_STATUS"

  while IFS=$'\t' read -r activity pid; do
    [[ $pid =~ ^[0-9]+$ ]] || continue
    if match=$(hypr_window_for_process_json "$pid" "$hypr_clients"); then
      printf '%s\n' "$match"
      return 0
    fi
  done < <(printf '%s\n' "$clients" | sort -t $'\t' -k1,1nr)

  return 1
}

local_desktop_sessions_json() {
  local hypr_clients clients name activity pid match status desktops='{}'
  if hypr_clients=$(hypr_clients_json); then
    :
  else
    status=$?
    (( status == INPUT_OVERFLOW_STATUS )) && return "$status"
    printf '{}\n'
    return
  fi
  if bounded_command_output clients "$MAX_TMUX_CLIENT_BYTES" \
      tmux_command_quiet list-clients \
      -F $'#{session_name}\t#{client_activity}\t#{client_pid}'; then
    :
  else
    status=$?
    (( status == INPUT_OVERFLOW_STATUS )) && return "$status"
    printf '{}\n'
    return
  fi

  jq -Rse '
    split("\n") | map(select(length > 0))
    | all(.[];
        split("\t") as $fields
        | ($fields | length) == 3
          and ($fields[0] | length) > 0
          and ($fields[1] | test("^[0-9]+$"))
          and ($fields[2] | test("^[0-9]+$")))
  ' <<<"$clients" >/dev/null 2>&1 || { printf '{}\n'; return; }
  jq -Rse \
    --argjson maxRows "$MAX_TMUX_CLIENTS" \
    --argjson maxName "$MAX_SESSION_NAME_BYTES" '
      split("\n") | map(select(length > 0))
      | length <= $maxRows
        and all(.[];
          split("\t")
          | (.[0] | utf8bytelength) <= $maxName
            and (.[1] | utf8bytelength) <= 20
            and (.[2] | utf8bytelength) <= 20)
    ' <<<"$clients" >/dev/null 2>&1 || return "$INPUT_OVERFLOW_STATUS"

  while IFS=$'\t' read -r name activity pid; do
    [[ -n $name && $pid =~ ^[0-9]+$ ]] || continue
    if jq -e --arg name "$name" 'has($name)' <<<"$desktops" >/dev/null; then
      continue
    fi
    if match=$(hypr_window_for_process_json "$pid" "$hypr_clients"); then
      desktops=$(jq -c --arg name "$name" --argjson window "$match" \
        '.[$name] = $window' <<<"$desktops")
    fi
  done < <(printf '%s\n' "$clients" | sort -t $'\t' -k1,1 -k2,2nr)

  printf '%s\n' "$desktops"
}

focus_desktop_address() {
  local address=$1
  [[ $address =~ ^0x[0-9A-Fa-f]+$ ]] || return 1

  # Hyprland 0.55+ dispatchers use Lua expressions. Keep the legacy form as
  # a fallback so Omamux remains usable on older Omarchy releases.
  "$HYPRCTL_BIN" dispatch \
    "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 \
    || "$HYPRCTL_BIN" dispatch focuswindow "address:$address" >/dev/null 2>&1
}

empty_state() {
  jq -cn --arg host "$HOST_ID" '{schemaVersion: 1, hosts: {($host): {favorites: []}}}'
}

read_state() {
  local state status
  if [[ ! -e $STATE_FILE ]]; then
    empty_state
    return
  fi

  [[ -f $STATE_FILE ]] || fail "Omamux state path is not a regular file: $STATE_FILE"
  if bounded_command_output state "$MAX_STATE_BYTES" \
      head -c "$((MAX_STATE_BYTES + 1))" -- "$STATE_FILE"; then
    :
  else
    status=$?
    if (( status == INPUT_OVERFLOW_STATUS )); then
      fail "Omamux state exceeds the $MAX_STATE_BYTES-byte safety limit: $STATE_FILE"
    fi
    fail "Unable to read Omamux state: $STATE_FILE"
  fi

  jq -ce \
    --arg host "$HOST_ID" \
    --argjson maxFavorites "$MAX_FAVORITES" \
    --argjson maxName "$MAX_SESSION_NAME_BYTES" '
    select(.schemaVersion == 1)
    | select((.hosts | type) == "object")
    | select((.hosts[$host] | type) == "object")
    | select((.hosts[$host].favorites | type) == "array")
    | select((.hosts[$host].favorites | length) <= $maxFavorites)
    | select(all(.hosts[$host].favorites[];
        (.name | type) == "string"
        and (.name | length) > 0
        and (.name | utf8bytelength) <= $maxName
        and (.starredAt | type) == "number"))
  ' <<<"$state" 2>/dev/null \
    || fail "Omamux state is malformed or exceeds safety limits; fix or move $STATE_FILE and retry"
}

state_favorites() {
  local state
  capture_json state read_state
  jq -c --arg host "$HOST_ID" '.hosts[$host].favorites' <<<"$state"
}

write_favorites() {
  local favorites=$1
  local state next tmp state_dir
  capture_json state read_state
  next=$(jq -c --arg host "$HOST_ID" --argjson favorites "$favorites" \
    '.hosts[$host].favorites = $favorites' <<<"$state")
  string_fits "$next" "$MAX_STATE_BYTES" \
    || fail "Omamux state would exceed the $MAX_STATE_BYTES-byte safety limit"

  state_dir=$(dirname -- "$STATE_FILE")
  mkdir -p -- "$state_dir"
  tmp=$(mktemp "$state_dir/.favorites.json.tmp.XXXXXX")
  chmod 600 "$tmp"
  printf '%s\n' "$next" >"$tmp"
  mv -f -- "$tmp" "$STATE_FILE"
}

validate_session_name() {
  local name=${1:-}
  [[ -n $name ]] || fail "Session name cannot be empty"
  string_fits "$name" "$MAX_SESSION_NAME_BYTES" \
    || fail "Session names cannot exceed $MAX_SESSION_NAME_BYTES bytes"
  [[ $name != *.* && $name != *:* ]] \
    || fail "Session names cannot contain '.' or ':'"
  [[ ! $name =~ [[:cntrl:]] ]] \
    || fail "Session names cannot contain control characters"
}

list_sessions_json() {
  local output status excerpt
  if bounded_command_output output "$MAX_TMUX_SESSION_BYTES" \
      tmux_command list-sessions \
      -F $'#{session_name}\t#{session_windows}\t#{session_created}\t#{session_attached}'; then
    :
  else
    status=$?
    if (( status == INPUT_OVERFLOW_STATUS )); then
      fail "tmux session data exceeds the $MAX_TMUX_SESSION_BYTES-byte safety limit"
    fi
    if [[ $output == *"no server running"* || $output == *"no sessions"* \
        || $output == *"failed to connect"* || $output == *"error connecting to"* ]]; then
      printf '[]\n'
      return
    fi
    command_error_excerpt excerpt "$output"
    fail "Unable to list tmux sessions: $excerpt"
  fi

  if [[ -z $output ]]; then
    printf '[]\n'
    return
  fi

  jq -Rsc \
    --argjson maxRows "$MAX_TMUX_SESSIONS" \
    --argjson maxName "$MAX_SESSION_NAME_BYTES" '
    split("\n")
    | map(select(length > 0))
    | if length > $maxRows then error("too many tmux sessions") else . end
    | map(
        split("\t")
        | if length != 4 then error("unexpected tmux list format") else . end
        | if (.[0] | utf8bytelength) == 0
            or (.[0] | utf8bytelength) > $maxName
            or (.[1] | test("^[0-9]{1,20}$") | not)
            or (.[2] | test("^[0-9]{1,20}$") | not)
            or (.[3] | test("^[0-9]{1,20}$") | not)
          then error("tmux session field exceeds limits") else . end
        | {
            name: .[0],
            windows: (.[1] | tonumber),
            createdAt: (.[2] | tonumber),
            attachedClients: (.[3] | tonumber)
          }
      )
  ' <<<"$output" 2>/dev/null \
    || fail "Unable to parse tmux session data"
}

list_session_detail_json() {
  local name=$1 output status excerpt
  if bounded_command_output output "$MAX_TMUX_PANE_BYTES" \
      tmux_command list-panes -s -t "=$name" \
      -F $'#{window_index}\t#{window_name}\t#{window_active}\t#{pane_id}\t#{pane_index}\t#{pane_title}\t#{pane_current_command}\t#{pane_current_path}\t#{pane_active}'; then
    :
  else
    status=$?
    if (( status == INPUT_OVERFLOW_STATUS )); then
      fail "tmux pane data exceeds the $MAX_TMUX_PANE_BYTES-byte safety limit"
    fi
    command_error_excerpt excerpt "$output"
    fail "Unable to inspect tmux session '$name': $excerpt"
  fi

  jq -Rsc \
    --argjson maxRows "$MAX_TMUX_PANES" \
    --argjson maxWindowName "$MAX_WINDOW_NAME_BYTES" \
    --argjson maxTitle "$MAX_PANE_TITLE_BYTES" \
    --argjson maxCommand "$MAX_PANE_COMMAND_BYTES" \
    --argjson maxPath "$MAX_PANE_PATH_BYTES" '
    split("\n")
    | map(select(length > 0))
    | if length > $maxRows then error("too many tmux panes") else . end
    | map(
        split("\t")
        | if length != 9 then error("unexpected tmux pane format") else . end
        | if (.[0] | test("^[0-9]{1,20}$") | not)
            or (.[1] | utf8bytelength) > $maxWindowName
            or (.[2] | test("^[01]$") | not)
            or (.[3] | test("^%[0-9]{1,20}$") | not)
            or (.[4] | test("^[0-9]{1,20}$") | not)
            or (.[5] | utf8bytelength) > $maxTitle
            or (.[6] | utf8bytelength) > $maxCommand
            or (.[7] | utf8bytelength) > $maxPath
            or (.[8] | test("^[01]$") | not)
          then error("tmux pane field exceeds limits") else . end
        | {
            windowIndex: (.[0] | tonumber),
            windowName: .[1],
            windowActive: (.[2] == "1"),
            pane: {
              id: .[3],
              index: (.[4] | tonumber),
              title: .[5],
              command: .[6],
              path: .[7],
              active: (.[8] == "1")
            }
          }
      )
    | group_by(.windowIndex)
    | map({
        index: .[0].windowIndex,
        name: .[0].windowName,
        active: .[0].windowActive,
        panes: map(.pane)
      })
  ' <<<"$output" 2>/dev/null \
    || fail "Unable to parse tmux window and pane data"
}

list_command() {
  local hostname_value favorites sessions desktop_sessions version status
  if bounded_command_output hostname_value "$MAX_HOSTNAME_BYTES" hostname_command; then
    :
  else
    status=$?
    (( status == INPUT_OVERFLOW_STATUS )) \
      && fail "Hostname exceeds the $MAX_HOSTNAME_BYTES-byte safety limit"
    hostname_value=local
  fi
  capture_json favorites state_favorites

  if ! tmux_available; then
    jq -cn \
      --arg host "$HOST_ID" \
      --arg hostname "$hostname_value" \
      --argjson favorites "$favorites" \
      '{
        ok: true,
        error: "tmux is not installed",
        host: {id: $host, name: $hostname},
        tmux: {available: false, version: ""},
        sessions: [
          $favorites[] | {
            name,
            windows: 0,
            createdAt: 0,
            attachedClients: 0,
            nativeOrder: null,
            desktop: null,
            favorite: true,
            starredAt,
            running: false
          }
        ]
      }'
    return
  fi

  capture_json sessions list_sessions_json
  if desktop_sessions=$(local_desktop_sessions_json); then
    :
  else
    status=$?
    (( status == INPUT_OVERFLOW_STATUS )) \
      && fail "Hyprland or tmux client data exceeds Omamux safety limits"
    desktop_sessions='{}'
  fi
  if bounded_command_output version "$MAX_TMUX_VERSION_BYTES" tmux_command_quiet -V; then
    :
  else
    status=$?
    (( status == INPUT_OVERFLOW_STATUS )) \
      && fail "tmux version data exceeds the $MAX_TMUX_VERSION_BYTES-byte safety limit"
    version=''
  fi

  jq -cn \
    --arg host "$HOST_ID" \
    --arg hostname "$hostname_value" \
    --arg version "$version" \
    --argjson favorites "$favorites" \
    --argjson sessions "$sessions" \
    --argjson desktops "$desktop_sessions" '
      ($sessions | to_entries | map(.value + {
        nativeOrder: .key,
        desktop: ($desktops[.value.name] // null)
      })) as $nativeSessions
      | ($nativeSessions | map({key: .name, value: .}) | from_entries) as $byName
      | ($favorites | map(.name)) as $favoriteNames
      | {
          ok: true,
          error: "",
          host: {id: $host, name: $hostname},
          tmux: {available: true, version: $version},
          sessions:
            ([
              $favorites[]
              | if $byName[.name] != null then
                  $byName[.name] + {
                    favorite: true,
                    starredAt: .starredAt,
                    running: true
                  }
                else
                  {
                    name,
                    windows: 0,
                    createdAt: 0,
                    attachedClients: 0,
                    nativeOrder: null,
                    desktop: null,
                    favorite: true,
                    starredAt,
                    running: false
                  }
                end
            ] + [
              $nativeSessions[]
              | select(.name as $name | ($favoriteNames | index($name)) == null)
              | . + {favorite: false, starredAt: 0, running: true}
            ])
        }
    '
}

detail_command() {
  local name=${1:-} windows
  validate_session_name "$name"
  tmux_available || fail "tmux is not installed"
  tmux_command has-session -t "=$name" 2>/dev/null \
    || fail "tmux session '$name' no longer exists"

  capture_json windows list_session_detail_json "$name"
  jq -cn --arg name "$name" --argjson windows "$windows" \
    '{ok: true, action: "detail", session: $name, windows: $windows}'
}

launch_terminal() {
  local name=$1
  shift
  local launcher=${OMAMUX_TERMINAL_LAUNCHER:-}

  if [[ -n $launcher ]]; then
    [[ -x $launcher ]] || fail "Configured terminal launcher is not executable: $launcher"
    "$launcher" "$TMUX_BIN" "${TMUX_ARGS[@]}" -u "$@" -t "=$name" \
      || fail "Unable to launch a terminal for session '$name'"
    return
  fi

  command -v omarchy-launch-terminal >/dev/null 2>&1 \
    || fail "Omarchy's terminal launcher is not available"

  (nohup omarchy-launch-terminal "$TMUX_BIN" "${TMUX_ARGS[@]}" -u "$@" -t "=$name" \
      </dev/null >/dev/null 2>&1 &)
}

select_attach_target() {
  local name=$1 window_index=${2:-} pane_id=${3:-} pane_identity status
  [[ -n $window_index ]] || return 0
  [[ $window_index =~ ^[0-9]+$ ]] || fail "Window index must be a non-negative number"
  tmux_command display-message -p -t "=$name:$window_index" '#{window_id}' >/dev/null 2>&1 \
    || fail "tmux window '$name:$window_index' no longer exists"

  if [[ -n $pane_id ]]; then
    [[ $pane_id =~ ^%[0-9]+$ ]] || fail "Pane ID is invalid"
    if bounded_command_output pane_identity "$((MAX_SESSION_NAME_BYTES + 32))" \
        tmux_command_quiet display-message -p -t "$pane_id" \
        $'#{session_name}\t#{window_index}'; then
      :
    else
      status=$?
      (( status == INPUT_OVERFLOW_STATUS )) \
        && fail "tmux pane identity exceeds Omamux safety limits"
      fail "tmux pane '$pane_id' no longer exists"
    fi
    [[ $pane_identity == "$name"$'\t'"$window_index" ]] \
      || fail "tmux pane '$pane_id' is not in '$name:$window_index'"
  fi

  tmux_command select-window -t "=$name:$window_index" >/dev/null 2>&1 \
    || fail "Unable to select tmux window '$name:$window_index'"
  if [[ -n $pane_id ]]; then
    tmux_command select-pane -t "$pane_id" >/dev/null 2>&1 \
      || fail "Unable to select tmux pane '$pane_id'"
  fi
}

attach_command() {
  local name=${1:-} window_index=${2:-} pane_id=${3:-}
  local desktop address status
  validate_session_name "$name"
  tmux_available || fail "tmux is not installed"
  tmux_command has-session -t "=$name" 2>/dev/null \
    || fail "tmux session '$name' no longer exists"

  select_attach_target "$name" "$window_index" "$pane_id"

  if desktop=$(local_desktop_client_json "$name"); then
    address=$(jq -r '.address // empty' <<<"$desktop")
    if [[ -n $address ]] && focus_desktop_address "$address"; then
      jq -cn --arg name "$name" --argjson window "$desktop" \
        '{ok: true, action: "focus", session: $name, window: $window}'
      return
    fi
  else
    status=$?
    (( status == INPUT_OVERFLOW_STATUS )) \
      && fail "Hyprland or tmux client data exceeds Omamux safety limits"
  fi

  launch_terminal "$name" attach-session
  jq -cn --arg name "$name" '{ok: true, action: "attach", session: $name}'
}

create_command() {
  local name=${1:-}
  validate_session_name "$name"
  tmux_available || fail "tmux is not installed"

  if tmux_command has-session -t "=$name" 2>/dev/null; then
    fail "tmux session '$name' already exists"
  fi

  tmux_command new-session -d -s "$name" >/dev/null \
    || fail "Unable to create tmux session '$name'"
  launch_terminal "$name" attach-session
  jq -cn --arg name "$name" '{ok: true, action: "create", session: $name}'
}

rename_command() {
  local old_name=${1:-} new_name=${2:-}
  local favorites next output status excerpt
  validate_session_name "$old_name"
  validate_session_name "$new_name"
  tmux_available || fail "tmux is not installed"
  tmux_command has-session -t "=$old_name" 2>/dev/null \
    || fail "tmux session '$old_name' no longer exists"

  if [[ $old_name == "$new_name" ]]; then
    jq -cn --arg name "$new_name" --arg previous "$old_name" \
      '{ok: true, action: "rename", session: $name, previousSession: $previous}'
    return
  fi

  if tmux_command has-session -t "=$new_name" 2>/dev/null; then
    fail "tmux session '$new_name' already exists"
  fi

  capture_json favorites state_favorites
  next=$(jq -c --arg old "$old_name" --arg new "$new_name" '
    map(if .name == $old then .name = $new else . end)
  ' <<<"$favorites")

  if bounded_command_output output "$MAX_TMUX_COMMAND_BYTES" \
      tmux_command rename-session -t "=$old_name" "$new_name"; then
    :
  else
    status=$?
    (( status == INPUT_OVERFLOW_STATUS )) \
      && fail "tmux rename output exceeds the $MAX_TMUX_COMMAND_BYTES-byte safety limit"
    command_error_excerpt excerpt "$output"
    fail "Unable to rename tmux session '$old_name': $excerpt"
  fi

  if jq -e --arg old "$old_name" 'any(.[]; .name == $old)' <<<"$favorites" >/dev/null; then
    write_favorites "$next"
  fi

  jq -cn --arg name "$new_name" --arg previous "$old_name" \
    '{ok: true, action: "rename", session: $name, previousSession: $previous}'
}

favorite_toggle_command() {
  local name=${1:-}
  local favorites now next favorite
  validate_session_name "$name"
  capture_json favorites state_favorites
  now=$(date +%s%3N)

  next=$(jq -c --arg name "$name" --argjson at "$now" '
    if any(.[]; .name == $name) then
      map(select(.name != $name))
    else
      [{name: $name, starredAt: $at}] + .
    end
  ' <<<"$favorites")
  jq -e --argjson maxFavorites "$MAX_FAVORITES" \
    'length <= $maxFavorites' <<<"$next" >/dev/null \
    || fail "Omamux supports at most $MAX_FAVORITES favorites"
  write_favorites "$next"
  favorite=$(jq -cn --arg name "$name" --argjson favorites "$next" \
    'any($favorites[]; .name == $name)')
  jq -cn --arg name "$name" --argjson favorite "$favorite" \
    '{ok: true, action: "favorite-toggle", session: $name, favorite: $favorite}'
}

favorite_reorder_command() {
  (( $# > 0 )) || fail "Favorite reorder requires at least one session name"
  (( $# <= MAX_FAVORITES )) \
    || fail "Favorite reorder cannot exceed $MAX_FAVORITES session names"

  local name existing favorites names next
  local -a seen_names=()
  for name in "$@"; do
    validate_session_name "$name"
    for existing in "${seen_names[@]}"; do
      [[ $existing != "$name" ]] || fail "Favorite reorder contains duplicate session '$name'"
    done
    seen_names+=("$name")
  done

  capture_json favorites state_favorites
  names=$(printf '%s\0' "$@" | jq -Rsc 'split("\u0000")[:-1]')
  next=$(jq -cn --argjson current "$favorites" --argjson names "$names" '
    ($current | map({key: .name, value: .}) | from_entries) as $byName
    | if any($names[]; $byName[.] == null) then
        error("reorder includes a session that is not a favorite")
      else
        ([$names[] | $byName[.]]
          + [$current[] | select(.name as $name | ($names | index($name)) == null)])
      end
  ' 2>/dev/null) || fail "Favorite reorder includes a session that is not a favorite"

  write_favorites "$next"
  jq -cn --argjson favorites "$next" \
    '{ok: true, action: "favorite-reorder", favorites: ($favorites | map(.name))}'
}

usage() {
  fail "Usage: omamux list | detail <name> | attach <name> [window-index [pane-id]] | create <name> | rename <old-name> <new-name> | favorite toggle <name> | favorite reorder <name>..." 64
}

main() {
  local command=${1:-}
  case "$command" in
    list)
      (( $# == 1 )) || usage
      list_command
      ;;
    detail)
      (( $# == 2 )) || usage
      detail_command "$2"
      ;;
    attach)
      (( $# >= 2 && $# <= 4 )) || usage
      attach_command "$2" "${3:-}" "${4:-}"
      ;;
    create)
      (( $# == 2 )) || usage
      create_command "$2"
      ;;
    rename)
      (( $# == 3 )) || usage
      rename_command "$2" "$3"
      ;;
    favorite)
      local subcommand=${2:-}
      case "$subcommand" in
        toggle)
          (( $# == 3 )) || usage
          favorite_toggle_command "$3"
          ;;
        reorder)
          (( $# >= 3 )) || usage
          shift 2
          favorite_reorder_command "$@"
          ;;
        *) usage ;;
      esac
      ;;
    *) usage ;;
  esac
}

main "$@"
